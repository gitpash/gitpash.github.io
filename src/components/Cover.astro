---
import { coverSvg, pickFamily, type Family } from '../lib/cover';

interface Props {
	slug: string;
	family?: Family;
}

const { slug, family = pickFamily(slug) } = Astro.props;
const svg = coverSvg(slug, family);
---

<div class="cover" role="img" aria-label={`Abstract pixel-art cover (${family})`} set:html={svg} />

<style>
	.cover {
		border: 2px solid var(--frame);
		background: var(--surface);
		line-height: 0;
		aspect-ratio: 240 / 126;
		overflow: hidden;
	}
	.cover :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>
