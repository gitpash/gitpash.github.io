---
import { coverSvg, pickScene, type Scene } from '../lib/cover';

interface Props {
	slug: string;
	scene?: Scene;
}

const { slug, scene = pickScene(slug) } = Astro.props;
const svg = coverSvg(slug, scene);
---

<div class="cover" role="img" aria-label={`Isometric pixel-art cover: ${scene}`} set:html={svg} />

<style>
	.cover {
		border: 3px solid var(--frame);
		background: #fff;
		line-height: 0;
		aspect-ratio: 240 / 126;
		overflow: hidden;
	}
	.cover :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>
