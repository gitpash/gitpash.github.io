---
import { SITE_TITLE, GITHUB_URL, LINKEDIN_URL } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="glass">
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/cv">CV</HeaderLink>
		</div>
		<div class="nav-right">
			<div class="social-links">
				<a href={GITHUB_URL} target="_blank" rel="noopener">
					<span class="sr-only">GitHub</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18"
						><path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path></svg
					>
				</a>
				<a href={LINKEDIN_URL} target="_blank" rel="noopener">
					<span class="sr-only">LinkedIn</span>
					<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"
						><path
							fill="currentColor"
							d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
						></path></svg
					>
				</a>
			</div>
			<ThemeToggle />
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1.5em;
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: 1px solid var(--border);
	}

	h2 {
		margin: 0;
		font-size: 1.05em;
		font-weight: 600;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: var(--text);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		max-width: 1100px;
		margin: 0 auto;
		height: 52px;
	}

	nav a {
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.92em;
		font-weight: 400;
	}

	.internal-links {
		display: flex;
		gap: 0.25em;
	}

	.internal-links a {
		padding: 0.35em 0.7em;
		border-radius: 8px;
		transition: color 175ms ease, background-color 175ms ease;
	}

	.internal-links a:hover {
		color: var(--text);
		background: var(--hover-bg);
		text-decoration: none;
	}

	.internal-links a.active,
	.internal-links a.active:hover {
		color: var(--on-accent);
		background: var(--accent);
		text-decoration: none;
	}

	.nav-right {
		display: flex;
		align-items: center;
		gap: 0.4em;
	}

	.social-links {
		display: flex;
		gap: 0.15em;
	}

	.social-links a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: 8px;
		transition: background-color 175ms ease;
	}

	.social-links a:hover {
		color: var(--text);
		background: var(--hover-bg);
	}

	@media (pointer: coarse), (max-width: 720px) {
		.internal-links a {
			display: inline-flex;
			align-items: center;
			min-height: 44px;
		}

		.social-links a {
			width: 44px;
			height: 44px;
		}

		h2 a {
			display: inline-flex;
			align-items: center;
			min-height: 44px;
		}
	}

	/* Narrow screens: two rows of 44px, brand and social links on top, page links and the theme
	   toggle below. The sticky offset equals the top row, so the header is full-size at the top of
	   the page, only the bottom row stays pinned once the page is scrolled, and the top row is back
	   when the reader returns to the top. Pure CSS: the header stays in the flow, so nothing shifts. */
	@media (max-width: 720px) {
		header {
			--header-row: 44px;
			padding: 0 1em;
			top: calc(-1 * var(--header-row));
		}

		nav {
			flex-wrap: wrap;
			height: auto;
			gap: 0;
			padding: 0;
		}

		.nav-right {
			display: contents;
		}

		h2 {
			flex: 1;
			order: 1;
		}

		.social-links {
			order: 2;
		}

		.internal-links {
			order: 3;
			flex: 1 1 calc(100% - 52px);
			justify-content: space-between;
		}

		/* Links are inline-flex on narrow screens, so text-align has no effect: centre the label with
		   justify-content, and keep the horizontal padding so the active pill has room around it. */
		.internal-links a {
			flex: 1;
			justify-content: center;
			padding: 0.35em 0.5em;
			/* 4px transparent border + padding-box clip: the pill gets breathing room inside the 44px
			   row while the tap target stays 44px tall. */
			border: 4px solid transparent;
		}

		/* The `background` shorthand in the base hover/active rules resets background-clip. */
		.internal-links a,
		.internal-links a:hover,
		.internal-links a.active,
		.internal-links a.active:hover {
			background-clip: padding-box;
		}

		.nav-right > :global(.theme-toggle) {
			order: 4;
		}
	}
</style>
