---
interface Props {
	name: string;
	description: string;
	url: string;
	language: string;
	stars: number;
	topics: string[];
}

const { name, description, url, language, stars, topics } = Astro.props;
---

<div class="project-card">
	<div class="project-header">
		<h3>
			<a href={url} target="_blank" rel="noopener">{name}</a>
		</h3>
		<div class="project-meta">
			{language && <span class="language">{language}</span>}
			<span class="stars"><span class="star" aria-hidden="true">★</span> {stars}<span class="sr-only"> stars</span></span>
		</div>
	</div>
	<p class="project-description">{description || 'No description available'}</p>
	{topics.length > 0 && (
		<div class="project-topics">
			{topics.slice(0, 3).map((topic) => (
				<span class="topic-tag">{topic}</span>
			))}
		</div>
	)}
</div>

<style>
	.project-card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		padding: 1.5rem;
		box-shadow: var(--shadow-sm);
		transition: all var(--transition-base);
	}

	.project-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-lg);
		border-color: var(--border-strong);
	}

	.project-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 0.75rem;
	}

	.project-header h3 {
		margin: 0;
		font-size: 1.1rem;
		font-weight: 600;
	}

	@media (pointer: coarse), (max-width: 720px) {
		.project-header h3 a {
			display: inline-block;
			padding-block: 12px;
			margin-block: -12px;
		}
	}

	.project-header h3 a {
		color: var(--link);
		text-decoration: none;
	}

	.project-header h3 a:hover {
		text-decoration: underline;
	}

	.project-meta {
		display: flex;
		gap: 0.75rem;
		font-size: 0.85rem;
		color: var(--text-muted);
	}

	.language {
		padding: 0.2rem 0.5rem;
		background: var(--surface-muted);
		border-radius: 4px;
	}

	.stars {
		color: var(--text-muted);
	}

	.star {
		color: var(--star);
	}

	.project-description {
		color: var(--text-muted);
		font-size: 0.95rem;
		line-height: 1.6;
		margin-bottom: 1rem;
	}

	.project-topics {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.topic-tag {
		padding: 0.25rem 0.6rem;
		background: var(--accent-soft);
		color: var(--link);
		border-radius: 980px;
		font-size: 0.8rem;
	}
</style>
