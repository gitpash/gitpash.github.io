---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import Cover from '../components/Cover.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Minimap from '../components/Minimap.astro';

type Props = CollectionEntry<'blog'>['data'] & { headings?: MarkdownHeading[]; slug: string };

const { title, description, pubDate, updatedDate, heroImage, canonicalUrl, headings = [], scene, slug } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} canonicalUrl={canonicalUrl} image={`/covers/${slug}.png`} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.cover-wrap {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 0.5em auto 0;
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: var(--gray-dark);
				font-family: var(--font-serif-family);
				font-size: 1.125rem;
				line-height: 1.7;
			}
			.prose :global(h2),
			.prose :global(h3),
			.prose :global(h4) {
				font-family: var(--font-family);
				margin: 2em 0 0.6em;
				scroll-margin-top: 5rem;
			}
			.prose :global(a) {
				font-size: inherit;
				text-decoration: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 0.18em;
			}
			.prose :global(table) {
				font-family: var(--font-family);
				font-size: 0.9rem;
				border-collapse: collapse;
				margin-bottom: 1.75em;
			}
			.prose :global(th),
			.prose :global(td) {
				padding: 0.4rem 0.75rem;
				text-align: left;
				border-bottom: 1px solid var(--border);
			}
			.title {
				font-family: var(--font-family);
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				font-size: 2.4rem;
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: var(--gray);
			}
			.original-note {
				margin: 0 0 1em;
				font-size: 0.95rem;
				color: var(--gray);
			}
			.original-note a {
				color: var(--accent);
			}
			@media (max-width: 720px) {
				main {
					padding: 0;
				}
				.prose {
					padding: 0.5em 0;
					font-size: 1.05rem;
				}
				.title h1 {
					font-size: 1.9rem;
				}
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header />
		<Minimap headings={headings} />
		<main>
			<article>
				<div class="cover-wrap"><Cover slug={slug} scene={scene} /></div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{
							canonicalUrl && (
								<p class="original-note">
									Originally published on the company engineering blog.{' '}
									<a href={canonicalUrl} rel="canonical noopener" target="_blank">
										Read the original
									</a>
								</p>
						)
						}
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
		<script>
			import '../scripts/code-blocks.ts';
		</script>
	</body>
</html>
