---
import type { MarkdownHeading } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Cover from '../components/Cover.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Minimap from '../components/Minimap.astro';
import { SITE_TITLE, SITE_URL } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { headings?: MarkdownHeading[]; slug: string };

const { title, description, pubDate, updatedDate, heroImage, canonicalUrl, headings = [], cover, slug, tags, seoTitle } = Astro.props;

const pageUrl = `${SITE_URL}/blog/${slug}/`;
const imagePath = `/og/posts/${slug}.png`;
const jsonLd = [
	{
		'@type': 'BlogPosting',
		'@id': `${pageUrl}#post`,
		headline: title,
		description,
		datePublished: pubDate.toISOString(),
		dateModified: (updatedDate ?? pubDate).toISOString(),
		author: { '@id': `${SITE_URL}/#person` },
		publisher: { '@id': `${SITE_URL}/#person` },
		image: `${SITE_URL}${imagePath}`,
		mainEntityOfPage: canonicalUrl ?? pageUrl,
		inLanguage: 'en',
		keywords: tags.join(', ') || undefined,
	},
	{
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
			{ '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}/blog/` },
			{ '@type': 'ListItem', position: 3, name: title, item: pageUrl },
		],
	},
];

const others = (await getCollection('blog'))
	.filter((post) => post.id !== slug)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<html lang="en">
	<head>
		<BaseHead
			title={seoTitle ?? `${title} | ${SITE_TITLE}`}
			description={description}
			canonicalUrl={canonicalUrl}
			image={imagePath}
			imageAlt={`Social card for the post "${title}"`}
			type="article"
			publishedTime={pubDate}
			modifiedTime={updatedDate ?? pubDate}
			tags={tags}
			jsonLd={jsonLd}
		/>
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.cover-wrap {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 0.5em auto 0;
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: var(--text);
				font-family: var(--font-serif-family);
				font-size: 1.125rem;
				line-height: 1.7;
			}
			.prose :global(h2),
			.prose :global(h3),
			.prose :global(h4) {
				font-family: var(--font-family);
				margin: 2em 0 0.6em;
				scroll-margin-top: 5rem;
			}
			.prose :global(a) {
				font-size: inherit;
				text-decoration: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 0.18em;
			}
			.prose :global(table) {
				font-family: var(--font-family);
				font-size: 0.9rem;
				border-collapse: collapse;
				margin-bottom: 1.75em;
			}
			.prose :global(th),
			.prose :global(td) {
				padding: 0.4rem 0.75rem;
				text-align: left;
				border-bottom: 1px solid var(--border);
			}
			.title {
				font-family: var(--font-family);
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				font-size: 2.4rem;
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: var(--text-muted);
			}
			.original-note {
				margin: 0 0 1em;
				font-size: 0.95rem;
				color: var(--text-muted);
			}
			.original-note a {
				color: var(--link);
			}
			@media (max-width: 720px) {
				main {
					padding: 0;
				}
				.prose {
					padding: 0.5em 0;
					font-size: 1.05rem;
				}
				.title h1 {
					font-size: 1.9rem;
				}
			}
			.more ul {
				padding-left: 1.2em;
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header />
		<Minimap headings={headings} />
		<main>
			<article>
				<div class="cover-wrap"><Cover slug={slug} family={cover} /></div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{
							canonicalUrl && (
								<p class="original-note">
									Originally published on the company engineering blog.{' '}
									<a href={canonicalUrl} rel="canonical noopener" target="_blank">
										Read the original
									</a>
								</p>
						)
						}
						<hr />
					</div>
					<slot />
					{
						others.length > 0 && (
							<nav class="more" aria-labelledby="more-posts">
								<h2 id="more-posts">More from the blog</h2>
								<ul>
									{others.map((post) => (
										<li>
											<a href={`/blog/${post.id}/`}>{post.data.title}</a>
										</li>
									))}
								</ul>
								<p>
									All posts are on the <a href="/blog/">blog</a>, and <a href="/about/">the About page</a> tells who writes them.
								</p>
							</nav>
						)
					}
				</div>
			</article>
		</main>
		<Footer />
		<script>
			import '../scripts/code-blocks.ts';
		</script>
	</body>
</html>
