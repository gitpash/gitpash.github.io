---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.filter((p) => p.data.pubDate.getFullYear() <= 2017)
	.sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Early notes (2017) - ${SITE_TITLE}`}
			description="Honest archive of 2017 learning notes. Not a current portfolio."
		/>
	</head>
	<body>
		<Header />
		<main>
			<div class="early-page">
				<h1>Early notes (2017)</h1>
				<div class="preamble">
					<p>
						These posts are from 2017 — FreeCodeCamp-era practice apps, course write-ups,
						and first React experiments. I keep them as a dated archive, not as proof of
						current staff-level work.
					</p>
					<p>
						For who I am now, start with the <a href="/cv">CV</a> and
						<a href="/about">About</a> pages. Selected later writing (2021–2022 Medium
						notes on component libraries and Vite/Storybook) will be linked here once
						canonical URLs are confirmed.
					</p>
				</div>
				<ul class="early-list">
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<span class="title">{post.data.title}</span>
									<span class="date">
										<FormattedDate date={post.data.pubDate} />
									</span>
									{post.data.description && (
										<span class="desc">{post.data.description}</span>
									)}
								</a>
							</li>
						))
					}
				</ul>
				<p class="back">
					<a href="/blog">← All blog posts</a>
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.early-page {
		max-width: 720px;
		margin: 0 auto;
		padding: 2rem 1rem;
	}
	h1 {
		font-size: 2.2rem;
		margin-bottom: 1rem;
		text-align: center;
	}
	.preamble {
		line-height: 1.7;
		margin-bottom: 2rem;
		color: var(--gray);
	}
	.preamble p {
		margin-bottom: 1rem;
	}
	.early-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.early-list a {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		text-decoration: none;
		padding: 1rem;
		border-radius: 8px;
		background: var(--gray-light);
		color: inherit;
	}
	.early-list a:hover .title {
		color: var(--accent);
	}
	.title {
		font-weight: 600;
		font-size: 1.1rem;
	}
	.date {
		color: var(--gray);
		font-size: 0.9rem;
	}
	.desc {
		font-size: 0.95rem;
		color: var(--gray);
	}
	.back {
		margin-top: 2rem;
		text-align: center;
	}
</style>
