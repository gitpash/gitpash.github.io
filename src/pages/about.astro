---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION, GITHUB_URL, LINKEDIN_URL, EMAIL } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="about-page">
				<h1>About Me</h1>
				<div class="about-content">
					<p>
						I'm Pavel Luzanov, a Tech Lead and staff-level product engineer based in
						Tokyo, Japan. I started in frontend engineering and developed deep expertise
						in React, TypeScript, and UI architecture. Today my work spans product
						architecture, technical strategy, and delivery across domains.
					</p>
					<p>
						I work from the problem backwards: clarify the business goal, assess the
						domain and blast radius, choose a practical design, and coordinate the work
						needed to ship it. Much of my impact comes from architecture modernization,
						UI and engineering standardization, and better developer experience.
					</p>
					<p>
						I also design AI-agent workflows for implementation and review. They let me
						move quickly on broad tasks while keeping technical boundaries clear and
						bringing in specialists for backend, data, or performance-heavy work.
					</p>
					<p>
						I'm open to senior, staff, and tech-lead product engineering roles with
						relocation in Europe or North America. Feel free to reach out if you'd like
						to collaborate or talk about engineering.
					</p>
					<div class="contact-links">
						<a href={`mailto:${EMAIL}`} class="btn btn-primary">Email Me</a>
						<a href={GITHUB_URL} class="btn btn-secondary" target="_blank" rel="noopener">GitHub</a>
						<a href={LINKEDIN_URL} class="btn btn-secondary" target="_blank" rel="noopener">LinkedIn</a>
					</div>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about-page {
		max-width: 700px;
		margin: 0 auto;
		padding: 2rem 1rem;
	}

	h1 {
		font-size: 2.5rem;
		margin-bottom: 1.5rem;
		text-align: center;
	}

	.about-content {
		font-size: 1.1rem;
		line-height: 1.8;
	}

	.about-content p {
		margin-bottom: 1.5rem;
	}

	.contact-links {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
		margin-top: 2rem;
	}

	.btn {
		display: inline-block;
		padding: 0.75rem 1.5rem;
		border-radius: 8px;
		text-decoration: none;
		font-weight: 600;
		transition: all 0.2s ease;
		border: 2px solid transparent;
	}

	.btn-primary {
		background: var(--accent);
		color: white;
	}

	.btn-primary:hover {
		background: var(--accent-dark);
		transform: translateY(-2px);
	}

	.btn-secondary {
		background: transparent;
		color: var(--accent);
		border-color: var(--accent);
	}

	.btn-secondary:hover {
		background: var(--accent);
		color: white;
		transform: translateY(-2px);
	}
</style>
