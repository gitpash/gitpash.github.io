---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Page not found - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="not-found">
				<p class="code">404</p>
				<h1>Page not found</h1>
				<p class="lede">The page you asked for does not exist, or it moved.</p>
				<div class="actions">
					<a href="/" class="btn btn-primary">Home</a>
					<a href="/blog" class="btn btn-secondary">Blog</a>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.not-found {
		max-width: 520px;
		margin: 0 auto;
		padding: 5rem 1rem 6rem;
		text-align: center;
	}

	.code {
		font-family: var(--font-pixel-family);
		font-size: 1rem;
		letter-spacing: 0.1em;
		color: var(--text-muted);
		margin-bottom: 0.5rem;
	}

	h1 {
		font-size: 2.25rem;
		margin-bottom: 0.75rem;
	}

	.lede {
		color: var(--text-muted);
		margin-bottom: 1.75rem;
	}

	.actions {
		display: flex;
		gap: 0.6rem;
		justify-content: center;
		flex-wrap: wrap;
	}
</style>
