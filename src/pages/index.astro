---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE, GITHUB_URL, EMAIL, LINKEDIN_URL } from '../consts';
import { getGitHubRepos, getGitHubStats } from '../utils/github';

let repos = [];
let stats = null;

try {
	[repos, stats] = await Promise.all([getGitHubRepos(), getGitHubStats()]);
} catch (error) {
	console.error('Failed to fetch GitHub data:', error);
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero Section -->
			<section class="hero">
				<div class="hero-content">
					<h1>Pavel Luzanov</h1>
					<p class="tagline">Tech Lead · Staff-level Software Engineer</p>
					<p class="description">
						I turn ambiguous product problems into practical technical plans and shipped
						systems. My focus is frontend and product architecture, frontend platforms, engineering practices,
						and AI-augmented delivery. Based in Tokyo, open to relocation.
					</p>
					<div class="cta-buttons">
						<a href="/blog" class="btn btn-primary">Read Blog</a>
						<a href={GITHUB_URL} class="btn btn-secondary" target="_blank" rel="noopener">
							GitHub
						</a>
						<a href={LINKEDIN_URL} class="btn btn-secondary" target="_blank" rel="noopener">
							LinkedIn
						</a>
					</div>
				</div>
			</section>

			<!-- GitHub Stats -->
			{stats && (
				<section class="section stats-section">
					<div class="stats-grid">
						<div class="stat-card">
							<div class="stat-number">{stats.public_repos}</div>
							<div class="stat-label">Repositories</div>
						</div>
						<div class="stat-card">
							<div class="stat-number">{stats.followers}</div>
							<div class="stat-label">Followers</div>
						</div>
						<div class="stat-card">
							<div class="stat-number">{stats.following}</div>
							<div class="stat-label">Following</div>
						</div>
					</div>
				</section>
			)}

			<!-- Projects Section -->
			<section class="section" id="projects">
				<h2>Featured Projects</h2>
				<div class="projects-grid">
					{repos.map((repo) => (
						<ProjectCard
							name={repo.name}
							description={repo.description || ''}
							url={repo.html_url}
							language={repo.language || ''}
							stars={repo.stargazers_count}
							topics={repo.topics}
						/>
					))}
				</div>
				<div class="more-projects">
					<a href={GITHUB_URL} class="btn btn-secondary" target="_blank" rel="noopener">
						View All Projects on GitHub
					</a>
				</div>
			</section>

			<!-- About Section -->
			<section class="section" id="about">
				<h2>About Me</h2>
				<div class="about-content">
					<p>
						I'm a Tech Lead and staff-level product engineer at AnyMind Group. I started
						in frontend engineering and still bring deep expertise in React, TypeScript,
						and UI architecture, but my current scope is broader: I take an ambiguous
						business goal, map its domain and blast radius, shape a technical approach,
						and coordinate the work needed to deliver it.
					</p>
					<p>
						A large part of my work is modernizing architecture, standardizing UI and
						engineering practices, and improving developer experience. I also build
						AI-agent workflows that help teams decompose, implement, and review complex
						work, bringing in domain specialists when a task needs deeper backend, data,
						or performance expertise.
					</p>
					<p>
						I'm based in Tokyo and open to senior, staff, and tech-lead product
						engineering roles with relocation in Europe or North America.
					</p>
				</div>
			</section>

			<!-- Skills Section -->
			<section class="section" id="skills">
				<h2>Skills</h2>
				<div class="skills-grid">
					<div class="skill-category">
						<h3>Frontend & Product</h3>
						<div class="skills-list">
							<span class="skill-tag">TypeScript</span>
							<span class="skill-tag">React</span>
							<span class="skill-tag">UI Architecture</span>
							<span class="skill-tag">Frontend Platforms</span>
							<span class="skill-tag">Design Systems</span>
							<span class="skill-tag">GraphQL</span>
						</div>
					</div>
					<div class="skill-category">
						<h3>Systems & Delivery</h3>
						<div class="skills-list">
							<span class="skill-tag">Technical Strategy</span>
							<span class="skill-tag">Kotlin</span>
							<span class="skill-tag">Node.js</span>
							<span class="skill-tag">Search & Batch Systems</span>
						</div>
					</div>
					<div class="skill-category">
						<h3>Engineering Practice</h3>
						<div class="skills-list">
							<span class="skill-tag">Architecture Modernization</span>
							<span class="skill-tag">Developer Experience</span>
							<span class="skill-tag">Cross-functional Leadership</span>
							<span class="skill-tag">Agentic Workflows</span>
						</div>
					</div>
				</div>
			</section>

			<!-- Experience Section -->
			<section class="section" id="experience">
				<h2>Experience</h2>
				<div class="timeline">
					<div class="timeline-item">
						<div class="timeline-date">Jan 2020 — Present</div>
						<div class="timeline-content">
							<h3>Tech Lead / Head of Frontend · AnyMind Group</h3>
							<ul>
								<li>Lead architecture modernization, UI standardization, and engineering-practice improvements across teams.</li>
								<li>Turn business goals into scoped technical plans by mapping domains, blast radius, dependencies, and delivery strategy.</li>
								<li>Build complex cross-domain systems, including a Kotlin-based BFS search service for account similarity and batched processing.</li>
								<li>Provide functional people leadership through performance reviews and compensation discussions, with a primary focus on engineering culture and practices.</li>
							</ul>
						</div>
					</div>
					<div class="timeline-item">
						<div class="timeline-date">Apr 2019 — Dec 2019</div>
						<div class="timeline-content">
							<h3>Senior Frontend Engineer · AnyMind Group</h3>
							<p>Built and evolved production web applications in a fast-growing engineering organization.</p>
						</div>
					</div>
					<div class="timeline-item">
						<div class="timeline-date">Sep 2017 — Apr 2019</div>
						<div class="timeline-content">
							<h3>Frontend Engineer · 4xxi</h3>
							<p>Delivered web products and grew from frontend implementation into broader product engineering.</p>
						</div>
					</div>
					<div class="timeline-item">
						<div class="timeline-date">Mar 2017 — Sep 2017</div>
						<div class="timeline-content">
							<h3>Frontend Engineer · supp-energy</h3>
							<p>Built customer-facing web experiences and established a foundation in professional frontend development.</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Contact Section -->
			<section class="section" id="contact">
				<h2>Get In Touch</h2>
				<p>I'm open to senior, staff, and tech-lead product engineering opportunities, especially those involving relocation to Europe or North America.</p>
				<div class="contact-links">
					<a href={`mailto:${EMAIL}`} class="btn btn-primary">Email Me</a>
					<a href={GITHUB_URL} class="btn btn-secondary" target="_blank" rel="noopener">GitHub</a>
					<a href={LINKEDIN_URL} class="btn btn-secondary" target="_blank" rel="noopener">LinkedIn</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		text-align: center;
		padding: 4rem 1rem;
		background: linear-gradient(135deg, rgba(var(--gray-light), 30%), transparent);
		border-radius: 16px;
		margin-bottom: 3rem;
	}

	.hero h1 {
		font-size: 3.5rem;
		margin-bottom: 0.5rem;
		background: linear-gradient(135deg, var(--accent), var(--accent-dark));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.tagline {
		font-size: 1.5rem;
		color: rgb(var(--gray));
		margin-bottom: 1rem;
	}

	.description {
		font-size: 1.1rem;
		max-width: 600px;
		margin: 0 auto 2rem;
		color: rgb(var(--gray-dark));
	}

	.cta-buttons {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.btn {
		display: inline-block;
		padding: 0.75rem 1.5rem;
		border-radius: 8px;
		text-decoration: none;
		font-weight: 600;
		transition: all 0.2s ease;
		border: 2px solid transparent;
	}

	.btn-primary {
		background: var(--accent);
		color: white;
	}

	.btn-primary:hover {
		background: var(--accent-dark);
		transform: translateY(-2px);
	}

	.btn-secondary {
		background: transparent;
		color: var(--accent);
		border-color: var(--accent);
	}

	.btn-secondary:hover {
		background: var(--accent);
		color: white;
		transform: translateY(-2px);
	}

	.section {
		margin-bottom: 3rem;
	}

	.section h2 {
		font-size: 2rem;
		margin-bottom: 1.5rem;
		text-align: center;
	}

	.stats-section {
		margin-bottom: 2rem;
	}

	.stats-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: 1rem;
		max-width: 600px;
		margin: 0 auto;
	}

	.stat-card {
		text-align: center;
		padding: 1.5rem;
		background: white;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
	}

	.stat-number {
		font-size: 2rem;
		font-weight: 700;
		color: var(--accent);
	}

	.stat-label {
		font-size: 0.9rem;
		color: rgb(var(--gray));
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 1.5rem;
		max-width: 1000px;
		margin: 0 auto;
	}

	.more-projects {
		text-align: center;
		margin-top: 2rem;
	}

	.about-content {
		max-width: 700px;
		margin: 0 auto;
		text-align: center;
	}

	.skills-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 2rem;
		max-width: 900px;
		margin: 0 auto;
	}

	.skill-category {
		text-align: center;
	}

	.skill-category h3 {
		font-size: 1.2rem;
		margin-bottom: 1rem;
		color: var(--accent);
	}

	.skills-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		justify-content: center;
	}

	.skill-tag {
		padding: 0.4rem 0.8rem;
		background: rgb(var(--gray-light));
		border-radius: 20px;
		font-size: 0.9rem;
		color: rgb(var(--gray-dark));
	}

	.timeline {
		max-width: 700px;
		margin: 0 auto;
		position: relative;
		padding-left: 2rem;
	}

	.timeline::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--accent);
	}

	.timeline-item {
		position: relative;
		margin-bottom: 2rem;
	}

	.timeline-item::before {
		content: '';
		position: absolute;
		left: -2rem;
		top: 0.5rem;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--accent);
		margin-left: -5px;
	}

	.timeline-date {
		font-size: 0.9rem;
		color: var(--accent);
		font-weight: 600;
		margin-bottom: 0.25rem;
	}

	.timeline-content h3 {
		font-size: 1.1rem;
		margin-bottom: 0.25rem;
	}

	.timeline-content p {
		color: rgb(var(--gray));
		font-size: 0.95rem;
	}

	.timeline-content ul {
		margin: 0.75rem 0 0;
		padding-left: 1.25rem;
		color: rgb(var(--gray));
		font-size: 0.95rem;
	}

	.timeline-content li + li {
		margin-top: 0.5rem;
	}

	.contact-links {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
		margin-top: 1.5rem;
	}

	@media (max-width: 720px) {
		.hero h1 {
			font-size: 2.5rem;
		}

		.tagline {
			font-size: 1.2rem;
		}

		.skills-grid {
			grid-template-columns: 1fr;
		}

		.projects-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
