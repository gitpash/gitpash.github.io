---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE, GITHUB_URL, EMAIL, LINKEDIN_URL } from '../consts';
import { getGitHubRepos, getGitHubStats } from '../utils/github';

let repos = [];
let stats = null;

try {
	[repos, stats] = await Promise.all([getGitHubRepos(), getGitHubStats()]);
} catch (error) {
	console.error('Failed to fetch GitHub data:', error);
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero Section -->
			<section class="hero animate-fade-in-up">
				<div class="hero-content">
					<h1>Pavel Luzanov</h1>
					<p class="tagline">Front-end Developer</p>
					<p class="description">
						Passionate about building beautiful, functional web experiences.
						Currently based in Tokyo, Japan.
					</p>
					<div class="cta-buttons">
						<a href="/blog" class="btn btn-primary">Read Blog</a>
						<a href={GITHUB_URL} class="btn btn-secondary" target="_blank" rel="noopener">
							GitHub
						</a>
						<a href={LINKEDIN_URL} class="btn btn-secondary" target="_blank" rel="noopener">
							LinkedIn
						</a>
					</div>
				</div>
			</section>

			<!-- GitHub Stats -->
			{stats && (
				<section class="section stats-section animate-fade-in-up" style="animation-delay: 0.1s">
					<div class="stats-grid">
						<div class="stat-card">
							<div class="stat-number">{stats.public_repos}</div>
							<div class="stat-label">Repositories</div>
						</div>
						<div class="stat-card">
							<div class="stat-number">{stats.followers}</div>
							<div class="stat-label">Followers</div>
						</div>
						<div class="stat-card">
							<div class="stat-number">{stats.following}</div>
							<div class="stat-label">Following</div>
						</div>
					</div>
				</section>
			)}

			<!-- Projects Section -->
			<section class="section animate-fade-in-up" style="animation-delay: 0.2s" id="projects">
				<h2>Featured Projects</h2>
				<div class="projects-grid">
					{repos.map((repo) => (
						<ProjectCard
							name={repo.name}
							description={repo.description || ''}
							url={repo.html_url}
							language={repo.language || ''}
							stars={repo.stargazers_count}
							topics={repo.topics}
						/>
					))}
				</div>
				<div class="more-projects">
					<a href={GITHUB_URL} class="btn btn-secondary" target="_blank" rel="noopener">
						View All Projects on GitHub
					</a>
				</div>
			</section>

			<!-- About Section -->
			<section class="section animate-fade-in-up" style="animation-delay: 0.3s" id="about">
				<h2>About Me</h2>
				<div class="about-content">
					<p>
						I'm a front-end developer with a passion for creating intuitive and
						performant web applications. My journey started with a curiosity about
						how things work on the web, and it has evolved into a professional career
						building modern web experiences.
					</p>
					<p>
						I enjoy working with modern JavaScript frameworks, exploring new technologies,
						and contributing to open-source projects. When I'm not coding, you can find
						me exploring Tokyo, reading about technology, or working on side projects.
					</p>
				</div>
			</section>

			<!-- Skills Section -->
			<section class="section animate-fade-in-up" style="animation-delay: 0.4s" id="skills">
				<h2>Skills</h2>
				<div class="skills-grid">
					<div class="skill-category">
						<h3>Frontend</h3>
						<div class="skills-list">
							<span class="skill-tag">JavaScript</span>
							<span class="skill-tag">TypeScript</span>
							<span class="skill-tag">React</span>
							<span class="skill-tag">Astro</span>
							<span class="skill-tag">HTML/CSS</span>
						</div>
					</div>
					<div class="skill-category">
						<h3>Tools</h3>
						<div class="skills-list">
							<span class="skill-tag">Git</span>
							<span class="skill-tag">Webpack</span>
							<span class="skill-tag">Vite</span>
							<span class="skill-tag">npm</span>
						</div>
					</div>
					<div class="skill-category">
						<h3>Other</h3>
						<div class="skills-list">
							<span class="skill-tag">Node.js</span>
							<span class="skill-tag">Python</span>
							<span class="skill-tag">REST APIs</span>
							<span class="skill-tag">GraphQL</span>
						</div>
					</div>
				</div>
			</section>

			<!-- Experience Section -->
			<section class="section animate-fade-in-up" style="animation-delay: 0.5s" id="experience">
				<h2>Experience</h2>
				<div class="timeline">
					<div class="timeline-item">
						<div class="timeline-date">2020 - Present</div>
						<div class="timeline-content">
							<h3>Front-end Developer</h3>
							<p>Working on modern web applications with React and TypeScript</p>
						</div>
					</div>
					<div class="timeline-item">
						<div class="timeline-date">2017 - 2020</div>
						<div class="timeline-content">
							<h3>Web Developer</h3>
							<p>Built various web applications and explored different frameworks</p>
						</div>
					</div>
					<div class="timeline-item">
						<div class="timeline-date">2016 - 2017</div>
						<div class="timeline-content">
							<h3>Learning & Growth</h3>
							<p>Completed multiple courses and built projects with React</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Contact Section -->
			<section class="section animate-fade-in-up" style="animation-delay: 0.6s" id="contact">
				<h2>Get In Touch</h2>
				<p>Feel free to reach out if you'd like to collaborate or just chat about web development!</p>
				<div class="contact-links">
					<a href={`mailto:${EMAIL}`} class="btn btn-primary">Email Me</a>
					<a href={GITHUB_URL} class="btn btn-secondary" target="_blank" rel="noopener">GitHub</a>
					<a href={LINKEDIN_URL} class="btn btn-secondary" target="_blank" rel="noopener">LinkedIn</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		text-align: center;
		padding: 5rem 1rem;
		background: linear-gradient(180deg, rgb(var(--gray-light)) 0%, rgb(var(--background)) 100%);
		border-radius: var(--radius-xl);
		margin-bottom: 3rem;
	}

	.hero h1 {
		font-size: 3.5rem;
		margin-bottom: 0.5rem;
		background: linear-gradient(135deg, var(--accent), var(--accent-dark));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.tagline {
		font-size: 1.5rem;
		color: rgb(var(--text-secondary));
		margin-bottom: 1rem;
		font-weight: 400;
	}

	.description {
		font-size: 1.1rem;
		max-width: 600px;
		margin: 0 auto 2rem;
		color: rgb(var(--text-secondary));
		line-height: 1.6;
	}

	.cta-buttons {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.section {
		margin-bottom: 3rem;
	}

	.section h2 {
		font-size: 2rem;
		margin-bottom: 1.5rem;
		text-align: center;
	}

	.stats-section {
		margin-bottom: 2rem;
	}

	.stats-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: 1rem;
		max-width: 600px;
		margin: 0 auto;
	}

	.stat-card {
		text-align: center;
		padding: 1.5rem;
		background: rgb(var(--surface));
		border: 1px solid rgb(var(--border));
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-sm);
	}

	.stat-number {
		font-size: 2rem;
		font-weight: 700;
		color: var(--accent);
	}

	.stat-label {
		font-size: 0.9rem;
		color: rgb(var(--text-secondary));
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 1.5rem;
		max-width: 1000px;
		margin: 0 auto;
	}

	.more-projects {
		text-align: center;
		margin-top: 2rem;
	}

	.about-content {
		max-width: 700px;
		margin: 0 auto;
		text-align: center;
	}

	.skills-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 2rem;
		max-width: 900px;
		margin: 0 auto;
	}

	.skill-category {
		text-align: center;
	}

	.skill-category h3 {
		font-size: 1.1rem;
		margin-bottom: 1rem;
		color: var(--accent);
		font-weight: 600;
	}

	.skills-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		justify-content: center;
	}

	.skill-tag {
		padding: 0.5rem 1rem;
		background: rgb(var(--gray-light));
		border-radius: 980px;
		font-size: 0.9rem;
		color: rgb(var(--text-primary));
	}

	.timeline {
		max-width: 700px;
		margin: 0 auto;
		position: relative;
		padding-left: 2rem;
	}

	.timeline::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--accent);
	}

	.timeline-item {
		position: relative;
		margin-bottom: 2rem;
	}

	.timeline-item::before {
		content: '';
		position: absolute;
		left: -2rem;
		top: 0.5rem;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--accent);
		margin-left: -5px;
	}

	.timeline-date {
		font-size: 0.9rem;
		color: var(--accent);
		font-weight: 600;
		margin-bottom: 0.25rem;
	}

	.timeline-content h3 {
		font-size: 1.1rem;
		margin-bottom: 0.25rem;
	}

	.timeline-content p {
		color: rgb(var(--text-secondary));
		font-size: 0.95rem;
	}

	.contact-links {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
		margin-top: 1.5rem;
	}

	@media (max-width: 720px) {
		.hero h1 {
			font-size: 2.5rem;
		}

		.tagline {
			font-size: 1.2rem;
		}

		.skills-grid {
			grid-template-columns: 1fr;
		}

		.projects-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
