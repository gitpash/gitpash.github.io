---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE, GITHUB_URL, EMAIL, LINKEDIN_URL } from '../consts';
import { getGitHubRepos, getGitHubStats } from '../utils/github';

let repos = [];
let stats = null;

try {
	[repos, stats] = await Promise.all([getGitHubRepos(), getGitHubStats()]);
} catch (error) {
	console.error('Failed to fetch GitHub data:', error);
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero: compact, two columns on wide screens -->
			<section class="hero animate-fade-in-up">
				<div class="hero-text">
					<p class="eyebrow">Front-end Developer · Tokyo, Japan</p>
					<h1>Pavel Luzanov</h1>
					<p class="description">
						I build beautiful, functional web experiences. Currently focused on
						modern React, TypeScript and AI-assisted workflows.
					</p>
					<div class="cta-buttons">
						<a href="/blog" class="btn btn-primary">Read Blog</a>
						<a href="/cv" class="btn btn-secondary">View CV</a>
						<a href={LINKEDIN_URL} class="btn btn-secondary" target="_blank" rel="noopener">
							LinkedIn
						</a>
					</div>
				</div>
				<div class="hero-side">
					<img
						class="avatar"
						src="https://github.com/gitpash.png?size=160"
						width="96"
						height="96"
						alt="Pavel Luzanov"
					/>
					{stats && (
						<div class="stats">
							<div class="stat">
								<span class="stat-num">{stats.public_repos}</span>
								<span class="stat-label">repos</span>
							</div>
							<div class="stat">
								<span class="stat-num">{stats.followers}</span>
								<span class="stat-label">followers</span>
							</div>
							<div class="stat">
								<span class="stat-num">{stats.following}</span>
								<span class="stat-label">following</span>
							</div>
						</div>
					)}
				</div>
			</section>

			<!-- Projects -->
			<section class="section animate-fade-in-up" style="animation-delay: 0.1s" id="projects">
				<div class="section-head">
					<h2>Featured Projects</h2>
					<a href={GITHUB_URL} class="section-link" target="_blank" rel="noopener">
						All on GitHub →
					</a>
				</div>
				<div class="projects-grid">
					{repos.map((repo) => (
						<ProjectCard
							name={repo.name}
							description={repo.description || ''}
							url={repo.html_url}
							language={repo.language || ''}
							stars={repo.stargazers_count}
							topics={repo.topics}
						/>
					))}
				</div>
			</section>

			<!-- About + Skills side by side -->
			<div class="two-col">
				<section class="section animate-fade-in-up" style="animation-delay: 0.2s" id="about">
					<h2>About Me</h2>
					<p>
						I'm a front-end developer with a passion for creating intuitive and
						performant web applications. My journey started with a curiosity about
						how things work on the web, and it has evolved into a professional career
						building modern web experiences.
					</p>
					<p>
						I enjoy working with modern JavaScript frameworks, exploring new
						technologies, and contributing to open-source projects.
					</p>
				</section>

				<section class="section animate-fade-in-up" style="animation-delay: 0.3s" id="skills">
					<h2>Skills</h2>
					<div class="skills-list">
						<div class="skill-group">
							<h3>Frontend</h3>
							<div class="tags">
								<span class="skill-tag">JavaScript</span>
								<span class="skill-tag">TypeScript</span>
								<span class="skill-tag">React</span>
								<span class="skill-tag">Astro</span>
								<span class="skill-tag">HTML/CSS</span>
							</div>
						</div>
						<div class="skill-group">
							<h3>Tools</h3>
							<div class="tags">
								<span class="skill-tag">Git</span>
								<span class="skill-tag">Webpack</span>
								<span class="skill-tag">Vite</span>
								<span class="skill-tag">npm</span>
							</div>
						</div>
						<div class="skill-group">
							<h3>Other</h3>
							<div class="tags">
								<span class="skill-tag">Node.js</span>
								<span class="skill-tag">Python</span>
								<span class="skill-tag">REST APIs</span>
								<span class="skill-tag">GraphQL</span>
							</div>
						</div>
					</div>
				</section>
			</div>

			<!-- Experience + Contact side by side -->
			<div class="two-col">
				<section class="section animate-fade-in-up" style="animation-delay: 0.4s" id="experience">
					<h2>Experience</h2>
					<div class="timeline">
						<div class="timeline-item">
							<div class="timeline-date">2020 — Present</div>
							<div class="timeline-content">
								<h3>Front-end Developer</h3>
								<p>Modern web applications with React and TypeScript</p>
							</div>
						</div>
						<div class="timeline-item">
							<div class="timeline-date">2017 — 2020</div>
							<div class="timeline-content">
								<h3>Web Developer</h3>
								<p>Various web applications, explored different frameworks</p>
							</div>
						</div>
						<div class="timeline-item">
							<div class="timeline-date">2016 — 2017</div>
							<div class="timeline-content">
								<h3>Learning & Growth</h3>
								<p>Multiple courses and React projects</p>
							</div>
						</div>
					</div>
				</section>

				<section class="section animate-fade-in-up" style="animation-delay: 0.5s" id="contact">
					<h2>Get In Touch</h2>
					<p>Feel free to reach out if you'd like to collaborate or just chat about web development.</p>
					<div class="contact-links">
						<a href={`mailto:${EMAIL}`} class="btn btn-primary">Email Me</a>
						<a href={GITHUB_URL} class="btn btn-secondary" target="_blank" rel="noopener">GitHub</a>
						<a href={LINKEDIN_URL} class="btn btn-secondary" target="_blank" rel="noopener">LinkedIn</a>
					</div>
				</section>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* Hero */
	.hero {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 3rem;
		padding: 2.5rem 2.5rem;
		background:
			radial-gradient(ellipse 60% 80% at 85% 0%, var(--accent-soft) 0%, transparent 70%),
			var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		margin-bottom: 2.5rem;
	}

	.eyebrow {
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--accent);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin-bottom: 0.5rem;
	}

	.hero h1 {
		font-size: clamp(2rem, 4vw, 2.75rem);
		margin-bottom: 0.5rem;
	}

	.description {
		font-size: 1.05rem;
		max-width: 540px;
		margin-bottom: 1.5rem;
		color: var(--text-secondary);
		line-height: 1.6;
	}

	.cta-buttons {
		display: flex;
		gap: 0.6rem;
		flex-wrap: wrap;
	}

	.hero-side {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		flex-shrink: 0;
	}

	.avatar {
		width: 96px;
		height: 96px;
		border-radius: 50%;
		border: 3px solid var(--surface);
		box-shadow: var(--shadow-md);
	}

	.stats {
		display: flex;
		gap: 1.25rem;
	}

	.stat {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.stat-num {
		font-size: 1.35rem;
		font-weight: 700;
		color: var(--text-primary);
		line-height: 1.2;
	}

	.stat-label {
		font-size: 0.75rem;
		color: var(--text-secondary);
	}

	/* Sections */
	.section {
		margin-bottom: 2.5rem;
	}

	.section h2 {
		font-size: 1.5rem;
		margin-bottom: 1rem;
	}

	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 1rem;
	}

	.section-head h2 {
		margin-bottom: 0;
	}

	.section-link {
		font-size: 0.9rem;
		font-weight: 500;
	}

	.two-col {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2.5rem;
	}

	/* Projects */
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 1rem;
	}

	/* Skills */
	.skills-list {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.skill-group h3 {
		font-size: 0.85rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--text-secondary);
		margin-bottom: 0.5rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.skill-tag {
		padding: 0.3rem 0.7rem;
		background: var(--gray-light);
		border: 1px solid var(--border);
		border-radius: 8px;
		font-size: 0.85rem;
		color: var(--text-primary);
	}

	/* Timeline */
	.timeline {
		position: relative;
		padding-left: 1.5rem;
	}

	.timeline::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.4rem;
		bottom: 0.4rem;
		width: 2px;
		background: var(--border);
	}

	.timeline-item {
		position: relative;
		margin-bottom: 1.5rem;
	}

	.timeline-item:last-child {
		margin-bottom: 0;
	}

	.timeline-item::before {
		content: '';
		position: absolute;
		left: -1.5rem;
		top: 0.45rem;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--accent);
		transform: translateX(-3px);
	}

	.timeline-date {
		font-size: 0.82rem;
		color: var(--accent);
		font-weight: 600;
		margin-bottom: 0.15rem;
	}

	.timeline-content h3 {
		font-size: 1rem;
		margin-bottom: 0.15rem;
	}

	.timeline-content p {
		color: var(--text-secondary);
		font-size: 0.9rem;
		margin: 0;
	}

	/* Contact */
	#contact p {
		color: var(--text-secondary);
		margin-bottom: 1.25rem;
	}

	.contact-links {
		display: flex;
		gap: 0.6rem;
		flex-wrap: wrap;
	}

	/* Responsive */
	@media (max-width: 900px) {
		.two-col {
			grid-template-columns: 1fr;
			gap: 0;
		}

		.hero {
			flex-direction: column;
			text-align: center;
			gap: 1.5rem;
			padding: 2rem 1.5rem;
		}

		.description {
			margin-left: auto;
			margin-right: auto;
		}

		.cta-buttons {
			justify-content: center;
		}

		.hero-side {
			flex-direction: row;
			width: 100%;
			justify-content: center;
		}

		.contact-links {
			justify-content: flex-start;
		}
	}

	@media (max-width: 720px) {
		.projects-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
