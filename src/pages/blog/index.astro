---
import { getCollection } from 'astro:content';
import Cover from '../../components/Cover.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { PAGES } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={PAGES.blog.title} description={PAGES.blog.description} image="/og/blog.png" imageAlt="Blog of Pavel Luzanov: agent workflows and engineering notes" />
		<style>
			main {
				width: 720px;
				max-width: 100%;
			}
			h1 {
				margin: 0 0 1.5rem;
				font-size: 2rem;
			}
			.post-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
			}
			.post-list {
				gap: 0.9rem;
			}
			.post-list a {
				display: grid;
				grid-template-columns: 220px 1fr;
				gap: 1.25rem;
				align-items: start;
				padding: 14px;
				border: 1px solid var(--border);
				border-radius: 12px;
				text-decoration: none;
				color: inherit;
				transition: background-color 175ms ease, border-color 175ms ease, transform 175ms ease;
			}
			.post-list a :global(.cover) {
				border-radius: 8px;
			}
			@media (hover: hover) {
				.post-list a:hover {
					background: var(--hover-bg);
					border-color: color-mix(in srgb, var(--c-pink) 55%, var(--border));
					transform: translateY(-1px);
				}
			}
			@media (max-width: 600px) {
				.post-list a {
					grid-template-columns: 1fr;
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.post-list a {
					transition: none;
					transform: none !important;
				}
			}
			.title {
				margin: 0;
				font-size: 1.3rem;
				line-height: 1.3;
				color: var(--text);
			}
			.date {
				margin: 0.25rem 0 0.5rem;
				font-size: 0.9rem;
				color: var(--text-muted);
			}
			.summary {
				margin: 0;
				color: var(--text-muted);
				line-height: 1.5;
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main">
			<h1>Blog</h1>
			<ul class="post-list">
				{
					posts.map((post, i) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<Cover slug={post.id} family={post.data.cover} priority={i === 0} sizes="(min-width: 601px) 220px, 100vw" />
								<div>
								<h2 class="title">{post.data.title}</h2>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
								<p class="summary">{post.data.description}</p>
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
