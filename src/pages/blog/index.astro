---
import { getCollection } from 'astro:content';
import Cover from '../../components/Cover.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog - ${SITE_TITLE}`} description="Notes on engineering and agentic workflows." />
		<style>
			main {
				width: 720px;
				max-width: 100%;
			}
			h1 {
				margin: 0 0 1.5rem;
				font-size: 2rem;
			}
			.post-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
			}
			.post-list li + li {
				border-top: 1px solid var(--border);
			}
			.post-list a {
				display: grid;
				grid-template-columns: 220px 1fr;
				gap: 1.25rem;
				align-items: start;
				padding: 1.25rem 0;
				text-decoration: none;
				color: inherit;
			}
			@media (max-width: 600px) {
				.post-list a {
					grid-template-columns: 1fr;
				}
			}
			.post-list a:hover :global(.cover) {
				box-shadow: 4px 4px 0 var(--text-primary);
			}
			.title {
				margin: 0;
				font-size: 1.3rem;
				line-height: 1.3;
				color: var(--text-primary);
			}
			.date {
				margin: 0.25rem 0 0.5rem;
				font-size: 0.9rem;
				color: var(--gray);
			}
			.summary {
				margin: 0;
				color: var(--text-secondary);
				line-height: 1.5;
			}
			.post-list a:hover .title {
				color: var(--accent);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Blog</h1>
			<ul class="post-list">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<Cover slug={post.id} scene={post.data.scene} />
								<div>
								<h2 class="title">{post.data.title}</h2>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
								<p class="summary">{post.data.description}</p>
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
